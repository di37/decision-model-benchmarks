# Jev's hosted native SystemOne API
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=

# CLEF-Flash's native SystemOne server (not a vLLM/OpenAI chat endpoint)
CLEF_FLASH_URL=http://127.0.0.1:8710/v1/systemone
CLEF_FLASH_MODEL=clef-flash
CLEF_FLASH_API_KEY=

# Laya via laya.serve (docker/laya). Leave LAYA_MODEL blank so the Router picks
# the checkpoint; head_max_len=1024 keeps all 77 Banking77 options distinct.
LAYA_URL=http://127.0.0.1:8004/v1/systemone
LAYA_MODEL=
LAYA_MAX_LEN=2048
LAYA_HEAD_MAX_LEN=1024
LAYA_API_KEY=

# CLM via clm-serve with its Qwen3-8B embedding encoder
CLM_URL=http://127.0.0.1:8700/v1/systemone
CLM_MODEL=clm-latest
CLM_API_KEY=
