% Task box has an auto-incrementing counter: "Task 1", "Task 2", ...
\newcounter{brandtask}
\NewDocumentEnvironment{taskbox}{ o O{} }
  {\stepcounter{brandtask}%
   \begin{tcolorbox}[brandclue=clue-task,
     title={\faTasks\enspace Task \thebrandtask\IfValueT{#1}{: #1}}, #2]}
  {\end{tcolorbox}}

% Quotation box: \begin{quotationbox}[Attribution] ... \end{quotationbox}
\NewDocumentEnvironment{quotationbox}{ o O{} }
  {\begin{tcolorbox}[brandclue=clue-quotation, title={\faQuoteLeft\enspace Quotation}, #2]
   \itshape}
  {\IfValueT{#1}{\par\raggedleft\upshape\small\color{brandgray}\textendash{} #1\par}%
   \end{tcolorbox}}

% Generic clue: \begin{cluebox}{color}[Title or omit for headless][tcolorbox keys]
\NewDocumentEnvironment{cluebox}{ m o O{} }
  {\IfValueTF{#2}
     {\begin{tcolorbox}[brandclue=#1, title={#2}, #3]}
     {\begin{tcolorbox}[brandclue=#1, #3]}}
  {\end{tcolorbox}}

% Key insight box: navy background, mist italic text. Use 1-2 per document.
\NewDocumentEnvironment{insightbox}{ O{} }
