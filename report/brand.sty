% ============================================================
% STRUCTURED BLOCKS
% ============================================================

% --- Decision framework ---
% \begin{decision}
%   \decisionitem{dataset < 10K samples}{Few-shot prompting}{insufficient data for fine-tuning}
% \end{decision}
\newenvironment{decision}
  {\begin{tcolorbox}[enhanced, unbreakable, colback=ice, colframe=lightgray,
     boxrule=1pt, arc=4pt, left=12pt, right=12pt, top=8pt, bottom=8pt,
     before skip=10pt, after skip=10pt]\setlength{\parskip}{4pt}}
  {\end{tcolorbox}}
\newcommand\decisionitem[3]{%
  \par\noindent\textcolor{teal}{\textbf{If #1}}\ $\rightarrow$\ \textcolor{navy}{\textbf{#2}}: #3\par}

% --- Numbered steps ---
% \begin{steps}
%   \stepitem{Prepare dataset}{Clean, deduplicate, and split}
% \end{steps}
\newcounter{brandstep}
\newenvironment{steps}{\setcounter{brandstep}{0}\par\vspace{4pt}}{\par\vspace{4pt}}
\newcommand\stepitem[2]{%
  \stepcounter{brandstep}%
  \par\noindent\hspace*{8pt}%
  \tikz[baseline=(n.base)]\node[circle, fill=teal, inner sep=1.5pt, minimum size=15pt,
    text=white, font=\scriptsize\bfseries] (n) {\thebrandstep};%
  \hspace{6pt}\textbf{\color{navy}#1}\ifblank{#2}{}{: #2}\par\vspace{2pt}}

% --- Side-by-side comparison ---
% \comparison{Fine-tuning}{\item a \item b}{RAG}{\item c \item d}
\newcommand\comparison[4]{%
  \par\noindent
  \begin{tcbraster}[raster columns=2, raster equal height, raster column skip=12pt,
    raster before skip=10pt, raster after skip=10pt]
    \begin{tcolorbox}[colback=ice, colframe=teal, boxrule=1pt, arc=4pt,
      title={#1}, colbacktitle=ice, coltitle=teal, fonttitle=\bfseries, titlerule=0pt]
      \begin{itemize}[leftmargin=1.2em, topsep=0pt]#2\end{itemize}
    \end{tcolorbox}
    \begin{tcolorbox}[colback=ice, colframe=cyan, boxrule=1pt, arc=4pt,
      title={#3}, colbacktitle=ice, coltitle=cyan, fonttitle=\bfseries, titlerule=0pt]
      \begin{itemize}[leftmargin=1.2em, topsep=0pt]#4\end{itemize}
    \end{tcolorbox}
  \end{tcbraster}}

% ============================================================
% TABLES
% \begin{brandtable}[Caption\label{tab:x}]{lccc}{Metric, Baseline, Ours, Delta}
%   ROUGE-L & 38.2 & 44.7 & +6.5 \\
% \end{brandtable}
% Header cells containing commas must be wrapped in braces.
% ============================================================
\newcommand\brandth[1]{\multicolumn{1}{c}{\color{white}\bfseries\small #1}}
\ExplSyntaxOn
\tl_new:N \l__brand_header_tl
\bool_new:N \l__brand_first_bool
\cs_new_protected:Npn \__brand_build_header:n #1
  {
    \tl_clear:N \l__brand_header_tl
    \bool_set_true:N \l__brand_first_bool
    \clist_map_inline:nn {#1}
      {
        \bool_if:NTF \l__brand_first_bool
          { \bool_set_false:N \l__brand_first_bool }
          { \tl_put_right:Nn \l__brand_header_tl { & } }
        \tl_put_right:Nn \l__brand_header_tl { \brandth {##1} }
      }
    \tl_set_eq:NN \brand@header \l__brand_header_tl
  }
\cs_set_eq:NN \brand@buildheader \__brand_build_header:n
\ExplSyntaxOff

\NewDocumentEnvironment{brandtable}{ o m m +b }{%
  \par\addvspace{8pt}%
  \begingroup
  \centering\small
  \brand@buildheader{#3}%
  \rowcolors{2}{white}{ice}%
  \arrayrulecolor{lightgray}%
  \setlength\arrayrulewidth{0.5pt}%
  \renewcommand\arraystretch{1.45}%
  \begin{minipage}{\linewidth}
    \IfValueT{#1}{\captionsetup{hypcap=false}\captionof{table}{#1}}%
    \begin{tabularx}{\linewidth}{#2}
      \hline\rowcolor{navy}\brand@header\\\hline
      #4
      \hline
    \end{tabularx}%
  \end{minipage}%
  \par\endgroup
  \addvspace{8pt}%
}{}
\NewDocumentEnvironment{resultstable}{ o m m +b }
  {\IfValueTF{#1}{\begin{brandtable}[#1]{#2}{#3}#4\end{brandtable}}
                 {\begin{brandtable}{#2}{#3}#4\end{brandtable}}}{}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{C}{>{\centering\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}

