\tcbset{
  brandclue/.style={
    enhanced, sharp corners=west, arc=3pt, boxrule=0.6pt,
    colframe=#1!30!white, colback=#1!3!white,
    borderline west={3.5pt}{0pt}{#1},
    colbacktitle=#1!14!white, coltitle=#1!70!black,
    fonttitle=\bfseries\small,
    left=10pt, right=10pt, top=6pt, bottom=6pt,
    toptitle=3pt, bottomtitle=3pt,
    before skip=10pt, after skip=10pt,
    unbreakable,
  },
}

\NewDocumentCommand\brand@defclue{m m m m}{%
  \NewDocumentEnvironment{#1box}{ O{#4} O{} }
    {\begin{tcolorbox}[brandclue=#2, title={#3\enspace ##1}, ##2]}
    {\end{tcolorbox}}%
}
