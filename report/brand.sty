% ============================================================
% DOCUMENT METADATA — \brandsetup{key=value,...}
% ============================================================
\pgfkeys{
  /brand/.is family, /brand,
  title/.store in    = \brand@title,
  subtitle/.store in = \brand@subtitle,
  category/.store in = \brand@category,
  version/.store in  = \brand@version,
  doctype/.store in  = \brand@doctype,
  author/.store in   = \brand@author,
  date/.store in     = \brand@date,
  title    = {Document Title},
  subtitle = {},
  category = {},
  version  = {},
  doctype  = {guide},
  author   = {\brandname},
  date     = {\today},
}
\newcommand\brandsetup[1]{%
  \pgfkeys{/brand,#1}%
  \hypersetup{pdftitle={\brand@title}, pdfauthor={\brandname}, pdfsubject={\brand@doctype}}%
}

% ============================================================
% TYPOGRAPHY
% Brand fonts: Sora (display), Plus Jakarta Sans (body), Fira Code (mono).
% Sora and Plus Jakarta Sans ship as variable fonts, which XeTeX cannot
% instantiate at multiple weights, so static Inter is preferred for body
% text and TeX Gyre Heros is the last-resort fallback.
% ============================================================
\IfFontExistsTF{Inter}{%
  \setmainfont{Inter}[Scale=0.95]
  \setsansfont{Inter}[Scale=0.95]
  \newfontfamily\brand@displayfont{Inter Display}[Scale=0.95]
}{%
  \setmainfont{TeX Gyre Heros}
  \setsansfont{TeX Gyre Heros}
  \newfontfamily\brand@displayfont{TeX Gyre Heros}
}
\IfFontExistsTF{Fira Code}{%
  \setmonofont{Fira Code}[Scale=0.85]
}{%
  \setmonofont{DejaVu Sans Mono}[Scale=0.85]
}
\newcommand\displayfont{\brand@displayfont}

\linespread{1.25}
\AtBeginDocument{\color{navy}}
\setlength{\parskip}{0.6em plus 0.2em}
\setlist{itemsep=0.2em, topsep=0.3em}
\setlist[itemize]{label=\textcolor{teal}{\textbullet}}
\setlist[enumerate]{label=\textcolor{teal}{\bfseries\arabic*.}}

\hypersetup{linkcolor=navy, urlcolor=blue, citecolor=teal}

% --- Headings ---
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}
\titleformat{\section}
  {\displayfont\fontsize{20}{24}\selectfont\bfseries\color{navy}}
  {\thesection}{0.6em}{}
  [{\vspace{2pt}\color{teal}\titlerule[2pt]}]
\titlespacing*{\section}{0pt}{18pt}{10pt}
\titleformat{\subsection}
  {\displayfont\fontsize{15}{19}\selectfont\bfseries\color{navy}}
  {\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{14pt}{4pt}
\titleformat{\subsubsection}
  {\fontsize{12}{15}\selectfont\bfseries\color{teal}}
  {\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{10pt}{2pt}
% Keep headings with their first block (tcolorbox breaks titlesec's no-break chain)
\pretocmd{\section}{\Needspace{10\baselineskip}}{}{}
\pretocmd{\subsection}{\Needspace{7\baselineskip}}{}{}
\pretocmd{\subsubsection}{\Needspace{5\baselineskip}}{}{}

% --- Captions: tables on top, figures and code at the bottom ---
\captionsetup[table]{position=top, skip=6pt}
\captionsetup[figure]{position=bottom, skip=8pt}
\DeclareCaptionType[fileext=loc, placement=htbp]{codelisting}[Code][List of Code]
\captionsetup[codelisting]{position=bottom, skip=6pt, hypcap=false}
\crefname{codelisting}{Code}{Code}

% --- Header and footer (hidden on the title page) ---
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\color{brandgray}\itshape\brand@title}
\fancyhead[R]{\footnotesize\color{brandgray}\brandslogan}
\fancyfoot[L]{\footnotesize\color{brandgray}Created by \brandname}
\fancyfoot[R]{\footnotesize\color{brandgray}Page \thepage{} / \pageref*{LastPage}}
\renewcommand\headrule{{\color{lightgray}\hrule height 0.5pt width\headwidth\vskip-0.5pt}}
\renewcommand\footrule{{\color{lightgray}\hrule height 0.5pt width\headwidth\vskip 3pt}}
\renewcommand\footrulewidth{0.5pt}

% ============================================================
% TITLE PAGE — \maketitle
% ============================================================
\renewcommand\maketitle{%
  \begingroup
  \thispagestyle{empty}%
  \raggedright
  \vspace*{\fill}
  \ifx\brand@category\@empty\else
    \badge{\brand@category}\par\vspace{8pt}%
  \fi
  {\displayfont\fontsize{28}{34}\selectfont\bfseries\color{navy}\brand@title\par}
  \ifx\brand@subtitle\@empty\else
    \vspace{4pt}{\fontsize{14}{18}\selectfont\color{teal}\brand@subtitle\par}%
  \fi
  \vspace{16pt}
  {\color{teal}\rule{0.6\linewidth}{2pt}\par}
  \vspace{16pt}
  {\color{navy}\textbf{\brand@author} \textperiodcentered{} \brandtitle\\
   \brandslogan\\
   \branddescriptor\par}
  \vspace{8pt}
  {\small\color{brandgray}%
   \ifx\brand@version\@empty\else Version: \brand@version{} \textperiodcentered{} \fi
   \brand@date\par}
  \vspace*{\fill}
  {\footnotesize\color{brandgray}%
   \brandgithub{} \textperiodcentered{} \brandhuggingface\\
   \brandlinkedin\\
   \brandlocation\par}
  \endgroup
  \newpage
}

