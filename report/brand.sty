% Framed diagram canvas: \begin{brandflow}[tikz options] ... \end{brandflow}
\NewDocumentEnvironment{brandflow}{ O{} }
  {\begin{tcolorbox}[enhanced, unbreakable, colback=white, colframe=lightgray,
     boxrule=0.5pt, arc=4pt, halign=center, left=12pt, right=12pt, top=12pt, bottom=12pt]
   \begin{tikzpicture}[node distance=8mm and 10mm, #1]}
  {\end{tikzpicture}\end{tcolorbox}}

% Horizontal bar chart: \brandbarchart[max]{Label/value/display, ...}
\NewDocumentCommand\brandbarchart{O{1} m}{%
  \begin{tikzpicture}[x=1pt, y=1pt]
    \foreach \lab/\val/\disp [count=\i] in {#2} {
      \pgfmathsetmacro\brand@w{\val/#1*0.55*\linewidth}
      \pgfmathsetmacro\brand@y{-\i*22}
      \pgfmathparse{{"teal","blue","cyan","navy","amber","green"}[mod(\i-1,6)]}
      \edef\brand@bc{\pgfmathresult}
      \node[anchor=east, font=\footnotesize\bfseries, text=navy] at (-6, \brand@y) {\lab};
      \fill[\brand@bc, rounded corners=1.5pt] (0, \brand@y-8) rectangle ++(\brand@w, 16);
      \node[anchor=west, font=\footnotesize, text=brandgray] at (\brand@w+4, \brand@y) {\disp};
    }
  \end{tikzpicture}}

% Three-circle Venn diagram: \venthree{A}{B}{C}[center label]
\NewDocumentCommand\venthree{m m m o}{%
  \begin{tikzpicture}[font=\footnotesize\bfseries]
    \fill[blue, opacity=0.15]  (90:1.1)  circle (1.6);
    \fill[green, opacity=0.15] (210:1.1) circle (1.6);
    \fill[pink, opacity=0.15]  (330:1.1) circle (1.6);
    \draw[blue, line width=1pt]  (90:1.1)  circle (1.6);
    \draw[green, line width=1pt] (210:1.1) circle (1.6);
    \draw[pink, line width=1pt]  (330:1.1) circle (1.6);
    \node[text=blue]  at (90:2.0)  {#1};
    \node[text=green] at (210:2.0) {#2};
    \node[text=pink]  at (330:2.0) {#3};
    \IfValueT{#4}{\node[text=navy, font=\scriptsize\bfseries, align=center] at (0,0) {#4};}
  \end{tikzpicture}}

% pgfplots brand style: \begin{axis}[brand plot, ...]
\pgfplotscreateplotcyclelist{brand}{
  {blue, line width=1.4pt, mark=*, mark size=1.6pt},
  {teal, line width=1.4pt, mark=square*, mark size=1.6pt},
  {amber, line width=1.4pt, mark=triangle*, mark size=1.8pt},
  {navy, line width=1.4pt, mark=diamond*, mark size=1.8pt},
  {green, line width=1.4pt, mark=pentagon*, mark size=1.8pt},
}
\pgfplotsset{
  brand plot/.style={
    width=0.85\linewidth, height=6cm,
    cycle list name=brand,
    axis line style={lightgray}, tick style={lightgray},
    tick label style={font=\scriptsize, text=brandgray},
    label style={font=\footnotesize, text=navy},
    grid=major, grid style={lightgray, dashed},
    legend style={font=\scriptsize, draw=lightgray, fill=white, text=navy},
    legend cell align=left,
  },
}

